# ===========================================
# Damoa Application Environment Variables (HIP - Hospital Interior Platform)
# ===========================================
# Copy this file to .env and fill in your values

# Environment: local | dev | prod
ENVIRONMENT=local

# Database Configuration (PostgreSQL 16)
# DB Names by Environment:
# - Local: hip_damoa_local
# - Dev:   hip_damoa_dev
# - Prod:  hip_damoa_prod
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hip_damoa_local
DB_USERNAME=postgres
DB_PASSWORD=your-secure-password-here

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=  # Optional, for production use

# JWT Configuration
# Generate a secure key: openssl rand -base64 64
JWT_SECRET=your-jwt-secret-base64-encoded-min-64-chars

# OAuth Configuration
OAUTH_REDIRECT_BASE_URL=http://localhost:8080
KAKAO_CLIENT_ID=your-kakao-client-id
KAKAO_CLIENT_SECRET=your-kakao-client-secret
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=hip-damoa-files-local
AWS_REGION=ap-northeast-2
AWS_CLOUDFRONT_DOMAIN=  # Optional, for CDN

# File Upload Configuration
FILE_BASE_URL=https://hip-damoa-files-local.s3.ap-northeast-2.amazonaws.com

# Payment Gateway Configuration
# KakaoPay
KAKAOPAY_ADMIN_KEY=your-kakaopay-admin-key
KAKAOPAY_CID=TC0ONETIME
PAYMENT_APPROVAL_URL=http://localhost:8080/api/payments/kakaopay/success
PAYMENT_CANCEL_URL=http://localhost:8080/api/payments/kakaopay/cancel
PAYMENT_FAIL_URL=http://localhost:8080/api/payments/kakaopay/fail

# Toss Payments
TOSS_SECRET_KEY=test_sk_XXXXXXXXXXXXXXXXXXXXXXXXXXXX
TOSS_CLIENT_KEY=test_ck_XXXXXXXXXXXXXXXXXXXXXXXXXXXX

# INICIS
INICIS_MID=INIpayTest
INICIS_SIGN_KEY=SU5JTElURV9UUklQTEVERVNfS0VZU1RS

# Notification Configuration
# Email (SMTP)
EMAIL_NOTIFICATION_ENABLED=true
EMAIL_FROM=noreply@hip-damoa.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password  # Use App Password for Gmail

# SMS Configuration
SMS_NOTIFICATION_ENABLED=true
SMS_PROVIDER=ALIGO  # ALIGO | NCP
SMS_SENDER=01012345678

# Aligo SMS
ALIGO_API_KEY=your-aligo-api-key
ALIGO_USER_ID=your-aligo-user-id

# Naver Cloud Platform SMS (Alternative)
NCP_ACCESS_KEY=your-ncp-access-key
NCP_SECRET_KEY=your-ncp-secret-key
NCP_SERVICE_ID=ncp:sms:kr:your-service-id

# Google Analytics Configuration (Optional)
GA_PROPERTY_ID=your-ga-property-id
GA_SERVICE_ACCOUNT_KEY_PATH=./config/ga-service-account.json

# Application Specific Settings
APP_NAME=Hospital Interior Platform Damoa
APP_DOMAIN=hip-damoa.com
APP_VERSION=1.0.0

# Future Service Extensions (for reference)
# RIP (Residential Interior Platform): rip_damoa_*
# CIP (Commercial Interior Platform): cip_damoa_*
# OIP (Office Interior Platform): oip_damoa_*